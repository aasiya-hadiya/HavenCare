{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Non-sensitive user profile and role configuration for SmartCare AI.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "type": "string", "enum": ["patient", "caregiver", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateContact": {
      "title": "UserPrivateContact",
      "description": "Isolated PII contact details for a user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 32 },
        "emergencyNotes": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "PatientRecord": {
      "title": "PatientRecord",
      "description": "Patient monitoring profile, personal baseline metrics, and caregiver assignments.",
      "type": "object",
      "properties": {
        "patientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "ageGroup": { "type": "string", "maxLength": 40 },
        "baselineStatus": { "type": "string", "enum": ["not_started", "collecting", "ready"] },
        "baselineSamplesCount": { "type": "integer" },
        "baselineHeartRateMean": { "type": "number" },
        "baselineSpo2Mean": { "type": "number" },
        "baselineTempMean": { "type": "number" },
        "baselineSource": { "type": "string", "enum": ["sample_demo", "simulator", "esp32_hardware"] },
        "baselineModelTrained": { "type": "boolean" },
        "baselineModelVersion": { "type": "string", "maxLength": 80 },
        "baselineEcgBpmMean": { "type": "number" },
        "baselineActiveHrMean": { "type": "number" },
        "primaryCaregiverUid": { "type": "string", "maxLength": 128 },
        "secondaryCaregiverUid": { "type": "string", "maxLength": 128 },
        "primaryCaregiverName": { "type": "string", "maxLength": 100 },
        "secondaryCaregiverName": { "type": "string", "maxLength": 100 },
        "dataMode": { "type": "string", "enum": ["sample", "live"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "patientId",
        "ownerUid",
        "displayName",
        "baselineStatus",
        "baselineSamplesCount",
        "dataMode",
        "createdAt",
        "updatedAt"
      ]
    },
    "VitalReading": {
      "title": "VitalReading",
      "description": "Immutable vital-sign, motion, and ECG waveform telemetry record from wearable or simulator.",
      "type": "object",
      "properties": {
        "readingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "primaryCaregiverUid": { "type": "string", "maxLength": 128 },
        "secondaryCaregiverUid": { "type": "string", "maxLength": 128 },
        "heartRate": { "type": ["number", "null"] },
        "spo2": { "type": ["number", "null"] },
        "temperatureC": { "type": ["number", "null"] },
        "movementStatus": { "type": "string", "enum": ["resting", "walking", "active", "fall_suspect", "inactive"] },
        "accelMagnitude": { "type": "number" },
        "gyroMagnitude": { "type": "number" },
        "possibleFallDetected": { "type": "boolean" },
        "ecgSamples": { "type": "array" },
        "ecgSamplingRate": { "type": "number" },
        "ecgSignalQuality": { "type": "string", "enum": ["good", "noisy", "lead_off", "unavailable"] },
        "ecgLeadOff": { "type": "boolean" },
        "ecgTimestamp": { "type": "string", "maxLength": 60 },
        "ecgHeartRateBpm": { "type": "number" },
        "signalQuality": { "type": "string", "enum": ["good", "noisy", "poor_contact"] },
        "anomalyStatus": { "type": "string", "enum": ["insufficient_baseline", "paused_poor_quality", "normal", "anomalous"] },
        "anomalyScore": { "type": "number" },
        "alertLevel": { "type": "string", "enum": ["Normal", "Warning", "Critical"] },
        "contributingFeatures": { "type": "array" },
        "persistenceCount": { "type": "integer" },
        "modelVersion": { "type": "string", "maxLength": 80 },
        "source": { "type": "string", "enum": ["sample_demo", "simulator", "esp32_hardware"] },
        "mlEngine": { "type": "string", "enum": ["unconnected_rule_check", "python_isolation_forest"] },
        "explanation": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "readingId",
        "patientId",
        "ownerUid",
        "heartRate",
        "spo2",
        "temperatureC",
        "movementStatus",
        "signalQuality",
        "anomalyScore",
        "alertLevel",
        "source",
        "mlEngine",
        "explanation",
        "createdAt"
      ]
    },
    "AlertRecord": {
      "title": "AlertRecord",
      "description": "Early warning alert, caregiver acknowledgement, and escalation call log.",
      "type": "object",
      "properties": {
        "alertId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "primaryCaregiverUid": { "type": "string", "maxLength": 128 },
        "secondaryCaregiverUid": { "type": "string", "maxLength": 128 },
        "level": { "type": "string", "enum": ["Warning", "Critical"] },
        "status": { "type": "string", "enum": ["active", "acknowledged", "resolved"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 800 },
        "triggeredMetrics": { "type": "array" },
        "source": { "type": "string", "enum": ["sample_demo", "simulator", "esp32_hardware"] },
        "acknowledgedByUid": { "type": "string", "maxLength": 128 },
        "acknowledgedByName": { "type": "string", "maxLength": 100 },
        "followUpAction": { "type": "string", "maxLength": 500 },
        "callEscalationStatus": {
          "type": "string",
          "enum": ["not_triggered", "provider_unconfigured", "calling_primary", "primary_answered", "escalated_secondary", "completed"]
        },
        "callLog": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "alertId",
        "patientId",
        "ownerUid",
        "level",
        "status",
        "title",
        "explanation",
        "triggeredMetrics",
        "source",
        "callEscalationStatus",
        "callLog",
        "createdAt",
        "updatedAt"
      ]
    },
    "WearableDevice": {
      "title": "WearableDevice",
      "description": "Registered ESP32 wearable hardware unit and configurable sensor mapping.",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "patientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "boardType": { "type": "string", "maxLength": 60 },
        "pulseOxChipVariant": { "type": "string", "maxLength": 60 },
        "ecgSensor": { "type": "string", "maxLength": 60 },
        "imuSensor": { "type": "string", "maxLength": 60 },
        "tempSensor": { "type": "string", "maxLength": 60 },
        "displayModule": { "type": "string", "maxLength": 60 },
        "hapticModule": { "type": "string", "maxLength": 60 },
        "samplingIntervalMs": { "type": "integer" },
        "connectionStatus": { "type": "string", "enum": ["not_connected", "streaming", "offline"] },
        "lastSeenAt": { "type": "string", "maxLength": 60 },
        "firmwareVersion": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "deviceId",
        "label",
        "patientId",
        "ownerUid",
        "boardType",
        "pulseOxChipVariant",
        "imuSensor",
        "tempSensor",
        "displayModule",
        "hapticModule",
        "samplingIntervalMs",
        "connectionStatus",
        "firmwareVersion",
        "createdAt",
        "updatedAt"
      ]
    },
    "CareLink": {
      "title": "CareLink",
      "description": "Patient-to-caregiver monitoring and emergency escalation link.",
      "type": "object",
      "properties": {
        "linkId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "patientOwnerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "caregiverUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "caregiverName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "priority": { "type": "string", "enum": ["primary", "secondary"] },
        "status": { "type": "string", "enum": ["active", "pending", "revoked"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "linkId",
        "patientId",
        "patientName",
        "patientOwnerUid",
        "caregiverUid",
        "caregiverName",
        "priority",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Administrator-controlled monitoring and escalation configuration.",
      "type": "object",
      "properties": {
        "settingId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "escalationTimeoutSec": { "type": "integer" },
        "baselineMinSamples": { "type": "integer" },
        "samplingDefaultMs": { "type": "integer" },
        "warningPersistenceWindows": { "type": "integer" },
        "criticalPersistenceWindows": { "type": "integer" },
        "anomalyScoreThreshold": { "type": "number" },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["settingId", "escalationTimeoutSec", "baselineMinSamples", "samplingDefaultMs", "updatedByUid", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Administrator authorization lookup collection."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public/non-PII user profiles and role assignment."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateContact" },
      "description": "Isolated PII contact information readable only by owner or admin."
    },
    "/patients/{patientId}": {
      "schema": { "$ref": "#/entities/PatientRecord" },
      "description": "Monitored patient records, baselines, and assigned caregiver references."
    },
    "/patients/{patientId}/readings/{readingId}": {
      "schema": { "$ref": "#/entities/VitalReading" },
      "description": "Wearable vital readings subcollection scoped to patient and linked caregivers."
    },
    "/patients/{patientId}/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/AlertRecord" },
      "description": "Alerts and caregiver escalation workflow logs scoped to patient and caregivers."
    },
    "/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/WearableDevice" },
      "description": "Registered ESP32 wearable hardware units."
    },
    "/careLinks/{linkId}": {
      "schema": { "$ref": "#/entities/CareLink" },
      "description": "Patient-caregiver monitoring and escalation relationships."
    },
    "/systemSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSetting" },
      "description": "Global application thresholds and escalation timeouts."
    }
  }
}
